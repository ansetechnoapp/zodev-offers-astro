---
const currentYear = new Date().getFullYear();
---

<footer class="premium-footer">
  <div class="premium-footer__inner">
    <div class="premium-footer__brand">
      <p class="premium-footer__eyebrow">Kevin Otty</p>
      <h2 class="premium-footer__title">Offres web & mobile premium</h2>
      <p class="premium-footer__copy">
        Des livrables clairs, un périmètre net et un accompagnement direct du
        brief à la mise en ligne.
      </p>
    </div>

    <div class="premium-footer__links" aria-label="Liens rapides">
      <a href="/#hero">Accueil</a>
      <a href="/#offers">Offres</a>
      <a href="/#method">Méthode</a>
      <a href="/#process">Process</a>
      <a href="/#contact">Contact</a>
    </div>
  </div>

  <div class="premium-footer__meta">
    <span>Basé à Cotonou, Bénin</span>
    <span>Réponse sous 24h</span>
    <span>&copy; {currentYear} Kevin Otty</span>
  </div>
</footer>

<style>
  .premium-footer {
    margin-top: 0;
    border-top: 1px solid rgba(200, 169, 106, 0.24);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.48), rgba(255, 255, 255, 0.82)),
      var(--gray-999);
    padding: 1.5rem 0 1.75rem;
  }

  :root.theme-dark .premium-footer {
    background:
      linear-gradient(180deg, rgba(15, 23, 42, 0.48), rgba(15, 23, 42, 0.9)),
      var(--gray-999);
  }

  .premium-footer__inner {
    display: grid;
    gap: 1rem;
    margin-inline: auto;
    max-width: var(--container-max-width);
    padding-inline: var(--container-padding);
  }

  .premium-footer__brand {
    max-width: 42rem;
  }

  .premium-footer__eyebrow {
    margin: 0 0 0.5rem;
    color: #a88445;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .premium-footer__title {
    margin: 0;
    color: var(--gray-0);
    font-size: 1.4rem;
    line-height: 1.1;
  }

  .premium-footer__copy {
    margin: 0.75rem 0 0;
    max-width: 36rem;
    color: var(--text-muted-color);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .premium-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .premium-footer__links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(200, 169, 106, 0.22);
    border-radius: 999px;
    color: var(--text-muted-color);
    font-size: 0.85rem;
    padding: 0.5rem 0.85rem;
    text-decoration: none;
    transition:
      background-color var(--theme-transition),
      color var(--theme-transition),
      border-color var(--theme-transition),
      transform 0.2s ease;
  }

  .premium-footer__links a:hover,
  .premium-footer__links a:focus-visible {
    background: rgba(200, 169, 106, 0.12);
    border-color: rgba(200, 169, 106, 0.45);
    color: var(--gray-0);
    transform: translateY(-1px);
  }

  .premium-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    justify-content: space-between;
    margin-inline: auto;
    max-width: var(--container-max-width);
    padding: 1rem var(--container-padding) 0;
    color: var(--text-muted-color);
    font-size: 0.78rem;
  }

  .premium-footer__meta span {
    white-space: nowrap;
  }

  @media (min-width: 48em) {
    .premium-footer {
      padding: 2rem 0 2rem;
    }

    .premium-footer__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .premium-footer__title {
      font-size: 1.75rem;
    }
  }
</style>
